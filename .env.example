# Development defaults to SQLite when DATABASE_URL is unset.
SQLITE_PATH=.data/multi-chats.sqlite
# Set this to use PostgreSQL instead:
# DATABASE_URL=postgres://multi_chats:multi_chats@localhost:5432/multi_chats
APP_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
WORKER_POLL_INTERVAL_MS=1000

# Optional: used by `npm run verify:release-gate` for the default
# network-constrained DeepSeek profile.
# DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
